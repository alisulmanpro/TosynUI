{
  "name": "@tosynui/tokens",
  "version": "0.2.0",
  "description": "Tosyn design tokens in the W3C DTCG format, with CSS generation and contrast checks.",
  "keywords": [
    "tosyn",
    "design-tokens",
    "dtcg",
    "theme",
    "dark-mode",
    "wcag",
    "css-variables"
  ],
  "license": "MIT",
  "author": "Ali Sulman",
  "homepage": "https://tosynui.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alisulmanpro/TosynUI.git",
    "directory": "packages/tokens"
  },
  "bugs": {
    "url": "https://github.com/alisulmanpro/TosynUI/issues"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./base.tokens.json": "./dist/tokens/base.tokens.json",
    "./dark.tokens.json": "./dist/tokens/dark.tokens.json",
    "./ocean.tokens.json": "./dist/tokens/ocean.tokens.json",
    "./ocean.dark.tokens.json": "./dist/tokens/ocean.dark.tokens.json",
    "./forest.tokens.json": "./dist/tokens/forest.tokens.json",
    "./forest.dark.tokens.json": "./dist/tokens/forest.dark.tokens.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.10.0",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
