{
  "$description": "Tosyn default theme. Format: W3C Design Tokens 2025.10.",
  "color": {
    "$type": "color",
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.9686, 0.9725, 0.9804],
        "hex": "#f7f8fa"
      },
      "$description": "Page background."
    },
    "surface-raised": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1.0, 1.0, 1.0],
        "hex": "#ffffff"
      },
      "$description": "Background of featured sections and inputs."
    },
    "surface-sunken": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.9333, 0.9451, 0.9608],
        "hex": "#eef1f5"
      },
      "$description": "Background of subdued sections."
    },
    "ink": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0784, 0.1059, 0.1765],
        "hex": "#141b2d"
      },
      "$description": "Primary text."
    },
    "ink-muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.2902, 0.3333, 0.4078],
        "hex": "#4a5568"
      },
      "$description": "Secondary text, hints and units."
    },
    "outline": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.4784, 0.5216, 0.6],
        "hex": "#7a8599"
      },
      "$description": "Borders of inputs and outlined controls (3:1 against surfaces)."
    },
    "accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.1412, 0.2824, 0.8471],
        "hex": "#2448d8"
      },
      "$description": "Primary actions, links and emphasis."
    },
    "accent-ink": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1.0, 1.0, 1.0],
        "hex": "#ffffff"
      },
      "$description": "Text on accent backgrounds."
    },
    "accent-soft": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.9098, 0.9294, 1.0],
        "hex": "#e8edff"
      },
      "$description": "Subtle accent background."
    },
    "focus": {
      "$value": "{color.accent}",
      "$description": "Focus ring."
    },
    "info": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.1137, 0.3059, 0.8471],
        "hex": "#1d4ed8"
      },
      "$description": "Text of informational feedback."
    },
    "info-soft": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.902, 0.9373, 1.0],
        "hex": "#e6efff"
      },
      "$description": "Background of informational feedback."
    },
    "success": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0745, 0.4118, 0.2275],
        "hex": "#13693a"
      },
      "$description": "Text of success feedback."
    },
    "success-soft": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.8902, 0.9608, 0.9176],
        "hex": "#e3f5ea"
      },
      "$description": "Background of success feedback."
    },
    "warning": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.5412, 0.2941, 0.0],
        "hex": "#8a4b00"
      },
      "$description": "Text of warning feedback."
    },
    "warning-soft": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1.0, 0.9529, 0.8627],
        "hex": "#fff3dc"
      },
      "$description": "Background of warning feedback."
    },
    "danger": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.7059, 0.1373, 0.0941],
        "hex": "#b42318"
      },
      "$description": "Text of error feedback and destructive actions."
    },
    "danger-soft": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.9922, 0.9098, 0.9059],
        "hex": "#fde8e7"
      },
      "$description": "Background of error feedback."
    }
  },
  "space": {
    "$type": "dimension",
    "3xs": {
      "$value": {
        "value": 0.25,
        "unit": "rem"
      }
    },
    "2xs": {
      "$value": {
        "value": 0.5,
        "unit": "rem"
      }
    },
    "xs": {
      "$value": {
        "value": 0.75,
        "unit": "rem"
      }
    },
    "sm": {
      "$value": {
        "value": 1,
        "unit": "rem"
      }
    },
    "md": {
      "$value": {
        "value": 1.5,
        "unit": "rem"
      }
    },
    "lg": {
      "$value": {
        "value": 2,
        "unit": "rem"
      }
    },
    "xl": {
      "$value": {
        "value": 3,
        "unit": "rem"
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 0.375,
        "unit": "rem"
      }
    },
    "md": {
      "$value": {
        "value": 0.625,
        "unit": "rem"
      }
    },
    "lg": {
      "$value": {
        "value": 1,
        "unit": "rem"
      }
    }
  },
  "size": {
    "$type": "dimension",
    "control": {
      "$value": {
        "value": 2.75,
        "unit": "rem"
      },
      "$description": "Minimum height of controls; 44px keeps touch targets comfortable."
    },
    "screen": {
      "$value": {
        "value": 42,
        "unit": "rem"
      },
      "$description": "Maximum width of a screen."
    },
    "border": {
      "$value": {
        "value": 1,
        "unit": "px"
      }
    },
    "focus": {
      "$value": {
        "value": 3,
        "unit": "px"
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "base": {
        "$value": ["Inter", "ui-sans-serif", "system-ui", "sans-serif"]
      },
      "mono": {
        "$value": ["ui-monospace", "SFMono-Regular", "Consolas", "monospace"]
      }
    },
    "size": {
      "$type": "dimension",
      "sm": {
        "$value": {
          "value": 0.875,
          "unit": "rem"
        }
      },
      "md": {
        "$value": {
          "value": 1,
          "unit": "rem"
        }
      },
      "lg": {
        "$value": {
          "value": 1.25,
          "unit": "rem"
        }
      },
      "xl": {
        "$value": {
          "value": 1.625,
          "unit": "rem"
        }
      },
      "2xl": {
        "$value": {
          "value": 2.125,
          "unit": "rem"
        }
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      }
    },
    "line-height": {
      "$type": "number",
      "tight": {
        "$value": 1.2
      },
      "base": {
        "$value": 1.55
      }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": {
          "value": 120,
          "unit": "ms"
        }
      },
      "base": {
        "$value": {
          "value": 200,
          "unit": "ms"
        }
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": [0.2, 0, 0, 1]
      }
    }
  }
}
