{
  "name": "@tosynui/parser",
  "version": "0.1.0",
  "description": "Parses Tosyn markup into the Tosyn intermediate representation.",
  "keywords": [
    "tosyn",
    "parser",
    "markup",
    "ui",
    "ai"
  ],
  "license": "MIT",
  "author": "Ali Sulman",
  "homepage": "https://tosynui.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alisulmanpro/TosynUI.git",
    "directory": "packages/parser"
  },
  "bugs": {
    "url": "https://github.com/alisulmanpro/TosynUI/issues"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@tosynui/spec": "workspace:*",
    "htmlparser2": "12.0.0"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.10.0",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
