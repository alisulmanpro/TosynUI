{
  "name": "@tosynui/mcp",
  "version": "0.1.0",
  "description": "MCP server that lets AI tools check and render Tosyn markup.",
  "keywords": [
    "tosyn",
    "mcp",
    "model-context-protocol",
    "ai",
    "claude",
    "ui-generation"
  ],
  "license": "MIT",
  "author": "Ali Sulman",
  "homepage": "https://tosynui.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alisulmanpro/TosynUI.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/alisulmanpro/TosynUI/issues"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "tosyn-mcp": "dist/bin.js"
  },
  "scripts": {
    "generate": "node ../../scripts/embed-examples.mjs ../../examples src/examples.generated.ts",
    "build": "pnpm generate && tsc -p tsconfig.build.json",
    "start": "node dist/bin.js",
    "inspect": "pnpm build && pnpm dlx @modelcontextprotocol/inspector@2.16.0 node dist/bin.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@tosynui/ai": "workspace:*",
    "@tosynui/parser": "workspace:*",
    "@tosynui/render-html": "workspace:*",
    "@tosynui/rules": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "24.0.0",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.10.0",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
