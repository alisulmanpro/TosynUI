{
  "name": "@tosynui/ai",
  "version": "0.1.0",
  "private": true,
  "description": "AI tooling for Tosyn: a generated guide that teaches models to write Tosyn.",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@tosynui/rules": "workspace:*",
    "@tosynui/spec": "workspace:*"
  },
  "devDependencies": {
    "@tosynui/parser": "workspace:*",
    "@types/node": "24.0.0",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.10.0",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
