{
  "name": "@tosynui/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./dist/tosynui.css",
    "./styles.css": "./dist/tosynui.css",
    "./tokens.css": "./dist/tokens.css",
    "./setup-demo.css": "./dist/setup-demo.css",
    "./setup-demo.contract.json": "./dist/setup-demo.contract.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node ../build/dist/cli.js --input src/index.css --tokens src/tokens.json --contract src/demo.contract.json --output-dir dist",
    "dev": "node ../build/dist/cli.js --watch --input src/index.css --tokens src/tokens.json --contract src/demo.contract.json --output-dir dist",
    "lint": "stylelint \"src/**/*.css\"",
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/check-exports.mjs --report-dir coverage"
  },
  "devDependencies": {
    "@tosynui/build": "workspace:*",
    "typescript": "5.9.3"
  }
}
