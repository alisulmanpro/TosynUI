{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alisulmanpro/TosynUI/packages/spec/schema/catalog.schema.json",
  "title": "Tosyn element catalog",
  "description": "Defines the elements, attributes and nesting rules of one version of the Tosyn intent language.",
  "type": "object",
  "additionalProperties": false,
  "required": ["specVersion", "root", "elements"],
  "properties": {
    "specVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "root": { "$ref": "#/$defs/identifier" },
    "elements": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/element" }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "guidance", "attributes", "content", "children"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "guidance": { "type": "string", "minLength": 1 },
        "attributes": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "$ref": "#/$defs/attribute" }
        },
        "content": { "enum": ["elements", "text", "none"] },
        "children": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "attribute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "description"],
      "properties": {
        "type": { "enum": ["string", "identifier", "boolean", "enum"] },
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "required": { "type": "boolean" },
        "unique": {
          "description": "When true, no two elements of this type in one document may share the value.",
          "type": "boolean"
        },
        "default": { "type": ["string", "boolean"] },
        "description": { "type": "string", "minLength": 1 }
      },
      "if": { "properties": { "type": { "const": "enum" } } },
      "then": { "properties": { "values": true }, "required": ["values"] },
      "else": { "not": { "properties": { "values": true }, "required": ["values"] } }
    }
  }
}
