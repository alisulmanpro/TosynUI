<screen name="checkout" purpose="Let a customer enter delivery details and place an order.">
  <section name="delivery" emphasis="featured">
    <heading>Delivery details</heading>
    <field name="full-name" label="Full name" required />
    <field name="address" label="Delivery address" kind="multiline" required />
    <field name="city" label="City" required />
    <field name="phone" label="Phone number" kind="tel" hint="We call only if there is a problem with delivery." required />
    <action intent="submit" importance="primary">Place order</action>
    <action intent="navigate" importance="tertiary" target="/cart">Back to cart</action>
  </section>
</screen>
