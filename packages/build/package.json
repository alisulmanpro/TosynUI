{
  "name": "@tosynui/build",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "tosynui-build": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@tosynui/contracts": "workspace:*",
    "chokidar": "4.0.3",
    "postcss": "8.5.28",
    "postcss-import": "16.1.0"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.10.0",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
